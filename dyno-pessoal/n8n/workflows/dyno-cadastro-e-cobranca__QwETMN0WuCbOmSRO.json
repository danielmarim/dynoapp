    {
      "id": "6204955f-5fc8-4c6e-bd35-e8d9c7178c3e",
      "name": "Validar dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst b = raw.body ?? raw;\nconst h = raw.headers ?? {};\nconst ip = String(h['x-forwarded-for'] || h['x-real-ip'] || '').split(',')[0].trim();\nconst nome = String(b.nome || '').trim().replace(/\\s+/g, ' ');\nconst wa = String(b.whatsapp || '').replace(/\\D/g, '');\nconst email = String(b.email || '').trim().toLowerCase();\nconst cpf = String(b.cpf || '').replace(/\\D/g, '');\nconst barrar = (http, resposta) => [{ json: { seguir: false, http, resposta } }];\n\nfunction cpfValido(c) {\n  if (c.length !== 11 || /^(\\d)\\1{10}$/.test(c)) return false;\n  const dv = (n) => { let s = 0; for (let i = 0; i < n; i++) s += Number(c[i]) * (n + 1 - i); const r = (s * 10) % 11; return r === 10 ? 0 : r; };\n  return dv(9) === Number(c[9]) && dv(10) === Number(c[10]);\n}\n\nif (String(b.site || '').length > 0 || Number(b.tempo_ms || 0) < 2500) {\n  return barrar(200, { ok: true, status: 'pendente' });\n}\nconst okNome = nome.length >= 2 && nome.length <= 80;\nconst okWa = /^55[1-9][0-9]9[0-9]{8}$/.test(wa);\nconst okEmail = email.length <= 120 && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\nif (!okNome || !okWa || !okEmail || !cpfValido(cpf) || b.aceite !== true) {\n  return barrar(400, { ok: false, erro: 'dados_invalidos' });\n}\nreturn [{ json: {\n  seguir: true,\n  dados: {\n    nome, whatsapp: wa, email, ip, cpf,\n    origem: String(b.origem || 'direto').slice(0, 60),\n    termos: String(b.termos_versao || '').slice(0, 20)\n  }\n} }];"
      }
    },
