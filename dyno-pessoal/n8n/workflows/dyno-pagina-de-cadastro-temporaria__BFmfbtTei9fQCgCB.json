      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Dyno — seu assessor pessoal no WhatsApp</title>\n<meta name=\"description\" content=\"Registre gastos, contas, lembretes e tarefas conversando no WhatsApp. Piloto com 10 vagas: 2 meses grátis, depois R$ 14,90 por mês.\">\n<meta name=\"theme-color\" content=\"#FFF6EA\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,700;1,700&family=Space+Grotesk:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<style>:root{--cream:#FFF6EA;--navy:#1B1F3B;--green:#14B37D;--green-ink:#0B6E4D;--orange:#FF8A3D;--orange-ink:#A83A12;--mint:#D6F5E8;--card:#FFFFFF;--line:rgba(27,31,59,0.16);--muted:#4A4E6B;--radius:20px;--serif:\"Bodoni Moda\",Georgia,\"Times New Roman\",serif;--sans:\"Space Grotesk\",system-ui,-apple-system,\"Segoe UI\",sans-serif;}*{box-sizing:border-box;}html{scroll-behavior:smooth;}body{margin:0;background:var(--cream);color:var(--navy);font-family:var(--sans);font-size:18px;line-height:1.55;-webkit-font-smoothing:antialiased;background-image:radial-gradient(rgba(27,31,59,0.07) 1.5px,transparent 2px);background-size:40px 40px;}img,svg{max-width:100%;}a{color:var(--green-ink);text-underline-offset:3px;}a:hover{color:var(--navy);}:focus-visible{outline:3px solid var(--orange);outline-offset:3px;border-radius:6px;}.skip{position:absolute;left:12px;top:-60px;z-index:10;background:var(--navy);color:var(--cream);padding:12px 18px;border-radius:10px;}.skip:focus{top:12px;}.wrap{max-width:1080px;margin:0 auto;padding:0 20px;}.top{padding:22px 0;}.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;}.brand{display:inline-flex;align-items:center;gap:12px;text-decoration:none;color:var(--navy);}.brand-mark{width:46px;height:38px;border-radius:20px 20px 20px 6px;background:var(--green);border:3px solid var(--navy);display:inline-flex;align-items:center;justify-content:center;gap:4px;}.brand-mark i{width:6px;height:6px;border-radius:3px;background:var(--navy);display:block;}.brand-name{font-family:var(--serif);font-weight:700;font-size:30px;letter-spacing:-0.01em;}.badge{font-weight:700;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;border:3px solid var(--navy);border-radius:999px;padding:6px 14px;background:var(--card);}.hero{padding:28px 0 64px;}.hero .wrap{display:grid;gap:40px;align-items:center;}.kicker{font-weight:700;font-size:15px;letter-spacing:0.14em;text-transform:uppercase;color:var(--green-ink);margin:0 0 14px;}h1,h2,h3{font-family:var(--serif);line-height:1.06;margin:0;letter-spacing:-0.01em;}h1{font-size:clamp(44px,9vw,84px);font-weight:700;}h1 em{font-style:italic;color:var(--green-ink);}.lead{font-size:clamp(19px,3.4vw,24px);max-width:34em;margin:22px 0 30px;color:var(--navy);}.cta-row{display:flex;flex-wrap:wrap;gap:16px;align-items:center;}.cta-note{font-size:16px;color:var(--muted);}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 30px;border-radius:999px;border:3px solid var(--navy);background:var(--green);color:var(--navy);font:700 19px/1 var(--sans);text-decoration:none;cursor:pointer;box-shadow:5px 5px 0 var(--navy);transition:transform 0.12s ease,box-shadow 0.12s ease;}.btn:hover{transform:translate(2px,2px);box-shadow:3px 3px 0 var(--navy);color:var(--navy);}.btn:disabled{opacity:0.65;cursor:wait;transform:none;box-shadow:5px 5px 0 var(--navy);}.btn-full{width:100%;}.phone{background:var(--card);border:3px solid var(--navy);border-radius:32px;padding:22px;box-shadow:10px 10px 0 rgba(27,31,59,0.14);display:flex;flex-direction:column;gap:14px;max-width:440px;width:100%;margin:0 auto;}.phone-head{display:flex;align-items:center;gap:12px;padding-bottom:14px;border-bottom:2px solid var(--line);}.phone-head .brand-mark{width:40px;height:34px;}.phone-head strong{display:block;line-height:1.1;}.phone-head span{font-size:14px;color:var(--muted);}.bub{max-width:82%;padding:12px 16px;border:3px solid var(--navy);border-radius:22px;font-size:17px;line-height:1.4;margin:0;}.bub.me{align-self:flex-end;background:var(--green);border-bottom-right-radius:6px;}.bub.dy{align-self:flex-start;background:var(--cream);border-bottom-left-radius:6px;}.bub b{display:block;font-size:13px;letter-spacing:0.08em;text-transform:uppercase;color:var(--green-ink);margin-bottom:2px;}.typing{align-self:flex-start;display:inline-flex;gap:6px;padding:14px 18px;border:3px solid var(--navy);border-radius:22px 22px 22px 6px;background:var(--cream);}.typing i{width:9px;height:9px;border-radius:5px;background:var(--navy);display:block;animation:dot 1.2s infinite ease-in-out;}.typing i:nth-child(2){animation-delay:0.15s;}.typing i:nth-child(3){animation-delay:0.3s;}@keyframes dot{0%,60%,100%{transform:translateY(0);opacity:0.5;}30%{transform:translateY(-5px);opacity:1;}}section{padding:56px 0;}.section-title{font-size:clamp(34px,6vw,52px);font-weight:700;margin-bottom:14px;}.section-sub{max-width:36em;color:var(--muted);margin:0 0 32px;}.cards{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));}.card{background:var(--card);border:3px solid var(--navy);border-radius:var(--radius);padding:26px;}.card h3{font-size:28px;margin-bottom:10px;}.card p{margin:0;font-size:17px;}.steps{list-style:none;counter-reset:passo;margin:0;padding:0;display:grid;gap:16px;}.steps li{counter-increment:passo;position:relative;padding:22px 22px 22px 84px;background:var(--card);border:3px solid var(--navy);border-radius:var(--radius);}.steps li::before{content:counter(passo);position:absolute;left:20px;top:18px;width:46px;height:46px;border-radius:50%;background:var(--orange);color:var(--navy);border:3px solid var(--navy);display:flex;align-items:center;justify-content:center;font:700 24px/1 var(--serif);}.steps strong{display:block;font-size:20px;}.steps span{color:var(--muted);font-size:17px;}.signup{background:var(--navy);color:var(--cream);border-radius:36px;padding:40px 20px;margin:24px 0;}.signup .wrap{display:grid;gap:32px;align-items:start;}.signup h2{font-size:clamp(36px,6.5vw,58px);}.signup h2 em{color:var(--orange);}.signup p{color:#E7E1D6;}.price{display:inline-flex;flex-wrap:wrap;align-items:baseline;gap:10px 14px;margin:8px 0 18px;}.price strong{font-family:var(--serif);font-size:64px;line-height:1;color:var(--cream);}.price span{font-size:18px;color:#E7E1D6;}.vagas{display:inline-block;font-weight:700;color:var(--navy);background:var(--orange);border:3px solid var(--cream);border-radius:999px;padding:6px 16px;font-size:16px;}.form-card{background:var(--card);color:var(--navy);border:3px solid var(--cream);border-radius:28px;padding:28px 24px;}.form-card h3{font-size:30px;margin-bottom:4px;}.form-card .hint{margin:0 0 6px;}label{display:block;font-weight:700;margin:18px 0 6px;font-size:17px;}input[type=\"text\"],input[type=\"email\"],input[type=\"tel\"]{width:100%;min-height:54px;padding:0 16px;border:3px solid var(--navy);border-radius:14px;font:500 18px var(--sans);color:var(--navy);background:var(--cream);}input[aria-invalid=\"true\"]{border-color:#A32D0F;background:#FFF1EC;}.hint{font-size:15px;color:var(--muted);}.check{display:flex;gap:12px;align-items:flex-start;margin:22px 0 18px;font-weight:500;font-size:16px;}.check input{width:26px;height:26px;margin:2px 0 0;flex-shrink:0;accent-color:var(--green-ink);}.check label{margin:0;font-weight:500;font-size:16px;}.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;}.msg{min-height:1.6em;margin:14px 0 0;font-weight:500;font-size:16px;}.msg.erro{color:#A32D0F;}.msg.info{color:var(--muted);}.sucesso h3{font-size:36px;margin-bottom:10px;}.sucesso p{margin:0 0 18px;}.hidden{display:none !important;}.faq details{background:var(--card);border:3px solid var(--navy);border-radius:16px;margin-bottom:12px;}.faq summary{cursor:pointer;padding:16px 20px;font-weight:700;font-size:19px;min-height:52px;list-style-position:inside;}.faq details p{margin:0;padding:0 20px 18px;color:var(--muted);}.foot{background:var(--navy);color:#E7E1D6;padding:40px 0 48px;margin-top:56px;font-size:16px;}.foot a{color:var(--cream);}.foot-grid{display:grid;gap:18px;}.foot nav{display:flex;flex-wrap:wrap;gap:18px;}@media (min-width:860px){.hero .wrap{grid-template-columns:1.15fr 0.85fr;gap:56px;}.signup{padding:56px 20px;}.signup .wrap{grid-template-columns:1fr 1fr;gap:56px;}.steps{grid-template-columns:repeat(2,1fr);}.foot-grid{grid-template-columns:1.4fr 1fr;align-items:start;}}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto;}.typing i{animation:none;}.btn{transition:none;}}.signup .form-card p{color:var(--navy);}.signup .form-card .hint{color:var(--muted);}.signup .form-card .msg.erro{color:#A32D0F;}.signup .form-card .msg.info{color:var(--muted);}</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#vaga\">Ir para o cadastro</a>\n<header class=\"top\">\n  <div class=\"wrap\">\n    <a class=\"brand\" href=\"./\" aria-label=\"Dyno\">\n      <span class=\"brand-mark\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n      <span class=\"brand-name\">Dyno</span>\n    </a>\n    <span class=\"badge\">Piloto · 10 vagas</span>\n  </div>\n</header>\n<main>\n  <section class=\"hero\">\n    <div class=\"wrap\">\n      <div>\n        <p class=\"kicker\">Piloto com 10 vagas</p>\n        <h1>Seu assessor pessoal, <em>no WhatsApp.</em></h1>\n        <p class=\"lead\">Mande uma mensagem, o Dyno anota. Gastos, contas a pagar, lembretes e tarefas, sem planilha e sem baixar app.</p>\n        <div class=\"cta-row\">\n          <a class=\"btn\" href=\"#vaga\">Quero uma vaga</a>\n          <span class=\"cta-note\">2 meses grátis em troca do seu feedback</span>\n        </div>\n      </div>\n      <div class=\"phone\" aria-label=\"Exemplo de conversa com o Dyno\">\n        <div class=\"phone-head\">\n          <span class=\"brand-mark\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n          <div><strong>Dyno</strong><span>assessor pessoal</span></div>\n        </div>\n        <p class=\"bub me\">gastei 42 no mercado</p>\n        <p class=\"bub dy\"><b>Dyno</b>Anotado: R$ 42,00 em Mercado. Neste mês você já gastou R$ 318,00 nessa categoria.</p>\n        <p class=\"bub me\">me lembra de pagar a luz dia 10</p>\n        <div class=\"typing\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n      </div>\n    </div>\n  </section>\n  <section>\n    <div class=\"wrap\">\n      <h2 class=\"section-title\">O que o Dyno faz por você</h2>\n      <p class=\"section-sub\">Tudo pelo mesmo chat onde você já conversa o dia inteiro.</p>\n      <div class=\"cards\">\n        <article class=\"card\"><h3>Dinheiro no controle</h3><p>Diga o que gastou e o Dyno organiza por categoria, com resumo da semana e aviso de orçamento.</p></article>\n        <article class=\"card\"><h3>Contas e assinaturas</h3><p>Ele lembra os vencimentos e mostra o que você paga todo mês, para nada passar batido.</p></article>\n        <article class=\"card\"><h3>Casa e carro</h3><p>Revisão, troca de óleo, filtro da casa: registre uma vez e seja avisado na hora certa.</p></article>\n        <article class=\"card\"><h3>Lugares perto de você</h3><p>Mande sua localização e peça uma farmácia, um mercado ou um restaurante por perto.</p></article>\n      </div>\n    </div>\n  </section>\n  <section>\n    <div class=\"wrap\">\n      <h2 class=\"section-title\">Como funciona</h2>\n      <ol class=\"steps\">\n        <li><strong>Reserve sua vaga</strong><span>Preencha o cadastro abaixo, leva um minuto.</span></li>\n        <li><strong>Chame o Dyno no WhatsApp</strong><span>Você manda a primeira mensagem e a conversa começa.</span></li>\n        <li><strong>Use por dois meses grátis</strong><span>Em troca, conte para a gente o que funciona e o que não funciona.</span></li>\n        <li><strong>Depois, R$ 14,90 por mês</strong><span>Pix, cartão ou boleto. Cancele quando quiser.</span></li>\n      </ol>\n    </div>\n  </section>\n  <section class=\"signup\" id=\"vaga\">\n    <div class=\"wrap\">\n      <div>\n        <p class=\"kicker\" style=\"color:var(--orange)\">Piloto com 10 vagas</p>\n        <h2>Garanta sua <em>vaga.</em></h2>\n        <div class=\"price\"><strong>R$ 14,90</strong><span>por mês, depois de 2 meses grátis</span></div>\n        <p><span class=\"vagas hidden\" id=\"vagas\" aria-live=\"polite\"></span></p>\n        <p>Você não escolhe plano, não instala nada e pode cancelar a qualquer momento, sem multa.</p>\n      </div>\n      <div class=\"form-card\">\n        <form id=\"form-cadastro\" novalidate autocomplete=\"on\">\n          <h3>Reservar minha vaga</h3>\n          <p class=\"hint hint-top\">Leva menos de um minuto.</p>\n          <label for=\"nome\">Seu nome</label>\n          <input type=\"text\" id=\"nome\" name=\"nome\" autocomplete=\"name\" maxlength=\"80\" required>\n          <label for=\"whatsapp\">Seu WhatsApp</label>\n          <input type=\"tel\" id=\"whatsapp\" name=\"whatsapp\" inputmode=\"numeric\" autocomplete=\"tel-national\" placeholder=\"(11) 91234-5678\" maxlength=\"15\" required>\n          <p class=\"hint\">Com DDD. É por esse número que você vai falar com o Dyno.</p>\n          <label for=\"cpf\">Seu CPF</label>\n          <input type=\"text\" id=\"cpf\" name=\"cpf\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"000.000.000-00\" maxlength=\"14\" required>\n          <p class=\"hint\">Exigido pelo sistema de cobrança (Asaas) para emitir a mensalidade. Não cobramos nada agora.</p>\n          <label for=\"email\">Seu e-mail</label>\n          <input type=\"email\" id=\"email\" name=\"email\" autocomplete=\"email\" maxlength=\"120\" required>\n          <div class=\"hp\" aria-hidden=\"true\">\n            <label for=\"site\">Não preencha este campo</label>\n            <input type=\"text\" id=\"site\" name=\"site\" tabindex=\"-1\" autocomplete=\"off\">\n          </div>\n          <div class=\"check\">\n            <input type=\"checkbox\" id=\"aceite\" name=\"aceite\" required>\n            <label for=\"aceite\">Li e aceito os Termos de uso e a Política de privacidade (versão provisória, em revisão).</label>\n          </div>\n          <button class=\"btn btn-full\" type=\"submit\" id=\"form-btn\">Reservar minha vaga</button>\n          <p class=\"msg\" id=\"form-msg\" role=\"status\" aria-live=\"polite\"></p>\n          <p class=\"hint\">Você não paga nada agora. A primeira cobrança só acontece depois dos 2 primeiros meses.</p>\n        </form>\n        <div class=\"sucesso hidden\" id=\"sucesso\" tabindex=\"-1\">\n          <h3 id=\"sucesso-titulo\">Vaga reservada</h3>\n          <p id=\"sucesso-texto\"></p>\n          <a class=\"btn btn-full hidden\" id=\"sucesso-wa\" href=\"#\" target=\"_blank\" rel=\"noopener\">Chamar o Dyno no WhatsApp</a>\n        </div>\n      </div>\n    </div>\n  </section>\n  <section class=\"faq\">\n    <div class=\"wrap\">\n      <h2 class=\"section-title\">Perguntas frequentes</h2>\n      <details><summary>O Dyno é uma pessoa?</summary><p>Não. É uma inteligência artificial, e ela pode errar. Confira os valores importantes antes de tomar decisões.</p></details>\n      <details><summary>Preciso instalar algum aplicativo?</summary><p>Não. Tudo acontece no seu WhatsApp.</p></details>\n      <details><summary>Alguém mais vê os meus dados?</summary><p>Não. Suas informações ficam ligadas só ao seu número e não são vendidas nem compartilhadas para propaganda. Detalhes na Política de privacidade.</p></details>\n      <details><summary>Posso cancelar?</summary><p>Pode, quando quiser, sem multa e sem fidelidade.</p></details>\n      <details><summary>E se as vagas acabarem?</summary><p>Você entra na lista de espera e avisamos por e-mail quando abrirem novas vagas.</p></details>\n      <details><summary>O Dyno substitui um contador?</summary><p>Não. Ele ajuda a organizar o dia a dia, mas não oferece orientação financeira, jurídica ou contábil.</p></details>\n    </div>\n  </section>\n</main>\n<footer class=\"foot\"><div class=\"wrap foot-grid\"><div><strong>Dyno</strong><br>Página provisória do piloto</div></div></footer>\n<script>window.DYNO = {\n  api: \"https://n8n.srv1825327.hstgr.cloud/webhook/dyno-cadastro\",\n  vagasApi: \"https://n8n.srv1825327.hstgr.cloud/webhook/dyno-vagas\",\n  whatsapp: \"5511939497178\",\n  termosVersao: \"2026-10-03\"\n};\n(function () {\n\"use strict\";\nvar cfg = window.DYNO || {};\nvar $ = function (id) { return document.getElementById(id); };\nvar form = $(\"form-cadastro\"), btn = $(\"form-btn\"), msg = $(\"form-msg\");\nvar inCpf = $(\"cpf\"), inNome = $(\"nome\"), inWa = $(\"whatsapp\"), inEmail = $(\"email\"), inAceite = $(\"aceite\");\nvar abertura = Date.now();\nfunction digits(v) { return String(v || \"\").replace(/\\D/g, \"\"); }\nfunction nacional(v) {\nvar d = digits(v);\nif (d.length > 11 && d.indexOf(\"55\") === 0) d = d.slice(2);\nreturn d.slice(0, 11);\n}\nfunction mascara(d) {\nif (!d) return \"\";\nif (d.length <= 2) return \"(\" + d;\nif (d.length <= 7) return \"(\" + d.slice(0, 2) + \") \" + d.slice(2);\nreturn \"(\" + d.slice(0, 2) + \") \" + d.slice(2, 7) + \"-\" + d.slice(7);\n}\ninWa.addEventListener(\"input\", function () { inWa.value = mascara(nacional(inWa.value)); });\nfunction maskCpf(v) {\nvar d = digits(v).slice(0, 11);\nreturn d.replace(/^(\\d{3})(\\d)/, \"$1.$2\").replace(/^(\\d{3})\\.(\\d{3})(\\d)/, \"$1.$2.$3\").replace(/\\.(\\d{3})(\\d)/, \".$1-$2\");\n}\ninCpf.addEventListener(\"input\", function () { inCpf.value = maskCpf(inCpf.value); });\nfunction cpfValido(c) {\nc = digits(c);\nif (c.length !== 11 || /^(\\d)\\1{10}$/.test(c)) return false;\nfunction dv(n) { var s = 0; for (var i = 0; i < n; i++) s += Number(c[i]) * (n + 1 - i); var r = (s * 10) % 11; return r === 10 ? 0 : r; }\nreturn dv(9) === Number(c[9]) && dv(10) === Number(c[10]);\n}\nfunction setMsg(texto, tipo) {\nmsg.textContent = texto || \"\";\nmsg.className = \"msg\" + (tipo ? \" \" + tipo : \"\");\n}\nfunction marca(el, ruim) { el.setAttribute(\"aria-invalid\", ruim ? \"true\" : \"false\"); }\nvar ERROS = {\nwhatsapp_ja_cadastrado: \"Esse WhatsApp já está cadastrado. Se foi você, é só chamar o Dyno.\",\nemail_ja_cadastrado: \"Esse e-mail já está cadastrado. Use outro ou fale com a gente.\",\ndados_invalidos: \"Confira os dados e tente de novo.\",\nmuitas_tentativas: \"Muitas tentativas. Aguarde alguns minutos e tente de novo.\"\n};\nfunction utm() {\ntry {\nvar p = new URLSearchParams(location.search);\nvar o = p.get(\"utm_source\") || p.get(\"origem\") || \"\";\nreturn o.slice(0, 60) || \"direto\";\n} catch (e) { return \"direto\"; }\n}\nfunction validar() {\nvar nome = inNome.value.trim();\nvar d = nacional(inWa.value);\nvar email = inEmail.value.trim();\nvar okNome = nome.length >= 2;\nvar okWa = d.length === 11 && d.charAt(2) === \"9\";\nvar okEmail = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\nvar okCpf = cpfValido(inCpf.value);\nmarca(inNome, !okNome); marca(inWa, !okWa); marca(inCpf, !okCpf); marca(inEmail, !okEmail);\nif (!okNome) return { erro: \"Informe seu nome.\", foco: inNome };\nif (!okWa) return { erro: \"Informe o WhatsApp com DDD e o 9 na frente (11 dígitos).\", foco: inWa };\nif (!okCpf) return { erro: \"Confira o CPF: ele parece inválido.\", foco: inCpf };\nif (!okEmail) return { erro: \"Informe um e-mail válido.\", foco: inEmail };\nif (!inAceite.checked) return { erro: \"Para continuar, aceite os termos e a política de privacidade.\", foco: inAceite };\nreturn { dados: { nome: nome, whatsapp: \"55\" + d, email: email, cpf: digits(inCpf.value) } };\n}\nfunction sucesso(nome, status) {\nvar primeiro = nome.split(/\\s+/)[0];\nvar espera = status === \"espera\";\n$(\"sucesso-titulo\").textContent = espera ? \"Você está na lista de espera\" : \"Vaga reservada\";\n$(\"sucesso-texto\").tex