      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ZW = String.fromCharCode(8203);\nconst r = $input.first().json || {};\nconst msgs = Array.isArray(r.mensagens) ? r.mensagens : [];\nreturn msgs.filter(m => m && m.numero && m.texto).map(m => ({ json: { corpo: { number: String(m.numero), text: ZW + String(m.texto), delay: 1200 }, passo: m.passo } }));"
      }
    },
