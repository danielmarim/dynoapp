      "parameters": {
        "jsCode": "// Só o token de conexão (vale 30 min, escopo do widget) vai para o navegador.\nconst SANDBOX = true; // fase de testes: mostra o banco simulado da Pluggy\nconst t = $input.first().json || {};\nconst v = $('Supabase: validar link').first().json;\nif (!t.accessToken) return [{ json: { ok: false, erro: 'indisponivel' } }];\nreturn [{ json: { ok: true, token: t.accessToken, nome: v.nome || '', sandbox: SANDBOX } }];",
        "mode": "runOnceForAllItems"
      }
    },
