      "parameters": {
        "method": "POST",
        "url": "https://xvekgnbneeokihtjpbts.supabase.co/rest/v1/rpc/dyno_pos_cadastro_pendentes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
