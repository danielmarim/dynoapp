    {
      "id": "9e2a0af0-187c-4609-b55c-3ad3fce3d2d4",
      "name": "Um por mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// O n8n já separa a lista da RPC em itens; aceita também a lista inteira num item.\nconst out = [];\nfor (const i of $input.all()) {\n  const j = i.json || {};\n  const lista = Array.isArray(j) ? j : (Array.isArray(j.dyno_pos_cadastro_pendentes) ? j.dyno_pos_cadastro_pendentes : (j.id ? [j] : []));\n  for (const x of lista) if (x && x.id && x.numero && x.texto) out.push({ json: x });\n}\nreturn out;\n"
      }
    },
    {
      "id": "20e21ccf-2347-4c3f-8dca-5bfa572b99e6",
      "name": "Enviar (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        672,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://wa.dynoapp.com.br/message/sendText/dyno",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.numero, text: String.fromCharCode(8203) + '*⏰ Dina*' + String.fromCharCode(10) + $json.texto, delay: 1200 }) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 3000
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "id": "2629f212-073e-471d-afcd-e5b50c7b473e",
      "name": "Marcar enviado",
