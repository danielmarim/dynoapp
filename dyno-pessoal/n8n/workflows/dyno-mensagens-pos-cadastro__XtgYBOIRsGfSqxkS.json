        "jsonBody": "={{ JSON.stringify({ p_id: $('Um por mensagem').all()[$itemIndex].json.id, p_numero: $('Um por mensagem').all()[$itemIndex].json.numero, p_autor: $('Um por mensagem').all()[$itemIndex].json.autor, p_texto: '*⏰ Dina*' + String.fromCharCode(10) + $('Um por mensagem').all()[$itemIndex].json.texto }) }}",
        "options": {
