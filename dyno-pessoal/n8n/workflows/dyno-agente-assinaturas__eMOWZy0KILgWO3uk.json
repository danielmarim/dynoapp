      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Agente de assinaturas (08/10/2026): uma mensagem por cliente que tem algo a ver; resumo ao Daniel só quando houver envio.\nconst ZW = String.fromCharCode(8203), NL = String.fromCharCode(10);\nconst lista = $input.all().map(i => i.json).filter(x => x && x.autor && x.numero && x.texto);\nconst out = lista.map(x => ({ json: { number: String(x.numero), text: ZW + x.texto, delay: 1200 } }));\nif (out.length) {\n  out.push({ json: { number: '5511930851325', text: ZW + '🔁 *Agente de assinaturas*' + NL + 'Mensagens enviadas para ' + lista.map(x => x.autor + (x.sugestoes ? ' (' + x.sugestoes + ' sugestão(ões))' : '')).join(', ') + '.', delay: 800 } });\n}\nreturn out;"
      }
    },
