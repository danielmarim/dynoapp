{
  "id": "FAxcJprGwlZAyKhw",
  "name": "Dyno | Asaas webhook",
  "description": "Recebe os avisos de pagamento do Asaas (token verificado), registra o evento uma única vez e atualiza o status do cliente e os pagamentos no Supabase.",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "errorWorkflow": "5UUmuzItIYDsd3AG",
    "saveManualExecutions": false,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  },
  "nodes": [
    {
      "id": "a4f91d4d-ff26-4d69-855c-b2602df7e8e1",
      "name": "Recebe aviso do Asaas",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "dyno-asaas",
        "responseMode": "responseNode",
        "authentication": "headerAuth"
      },
      "webhookId": "8bb1ad2f-95bf-4442-9c5a-7fd050657b5d"
    },
    {
      "id": "fd6c2383-97d5-4571-be2e-a7f2600ee12e",
      "name": "Supabase: processar evento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://xvekgnbneeokihtjpbts.supabase.co/rest/v1/rpc/dyno_evento_asaas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_token: \"__P_TOKEN__\", p: $json.body }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "b32696af-8d02-498d-ac09-9447f5d90282",
      "name": "Responder ao Asaas",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: $json.ok === true } }}",
        "options": {
          "responseCode": "={{ $json.ok === true ? 200 : ($json.erro === \"token_invalido\" ? 401 : 500) }}"
        }
      }
    }
  ],
  "connections": {
    "Recebe aviso do Asaas": {
      "main": [
        [
          {
            "node": "Supabase: processar evento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: processar evento": {
      "main": [
        [
          {
            "node": "Responder ao Asaas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "tags": [],
  "versionId": "9682a86c-0384-46bf-920c-8cc2ca2c8d64"
}
