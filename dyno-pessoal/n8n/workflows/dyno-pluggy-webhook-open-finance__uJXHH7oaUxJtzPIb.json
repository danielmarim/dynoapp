          ]
        },
        "method": "GET",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "url": "={{ 'https://api.pluggy.ai/items/' + encodeURIComponent($('Webhook Pluggy').first().json.body.itemId) }}"
      }
    },
    {
      "id": "70a90940-da24-4bd6-8843-5b7ff32f39ad",
