    {
      "id": "861df2c2-98c7-4aa9-ae66-3a714ba461c9",
      "name": "Backups antigos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2960,
        100
      ],
      "parameters": {
        "jsCode": "// Mantém os 14 backups mais recentes (pelo nome com data); os mais antigos vão para a lixeira do Drive\nconst arquivos = $input.all().map(i => i.json).filter(f => f && f.id && /^dyno-backup-\\d{4}-\\d{2}-\\d{2}_\\d{4}\\.json$/.test(String(f.name || '')));\narquivos.sort((a, b) => String(b.name).localeCompare(String(a.name)));\nconst remover = arquivos.slice(14);\nreturn remover.length ? remover.map(f => ({ json: { id: f.id, name: f.name } })) : [];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
