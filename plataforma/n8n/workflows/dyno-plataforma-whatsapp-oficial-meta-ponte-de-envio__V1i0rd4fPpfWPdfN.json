        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", recipient_type: \"individual\", to: $(\"Áudio em arquivo\").first().json.numero, type: \"audio\", audio: { id: $json.id, voice: true } }) }}",
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "cfa99209-d41f-42fe-972a-d13a46066581",
