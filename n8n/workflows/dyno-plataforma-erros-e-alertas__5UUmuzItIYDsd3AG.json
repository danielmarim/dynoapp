{
  "id": "5UUmuzItIYDsd3AG",
  "name": "Dyno Plataforma | Erros e alertas",
  "description": "Recebe falhas dos workflows Dyno, registra no Supabase (retenção 7 dias) e avisa o Daniel no WhatsApp, sem repetir o mesmo erro por 15 min.",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "nodes": [
    {
      "id": "c47c1992-d05c-463c-9b16-d4e1dd3f844d",
      "name": "Erro em workflow",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "dfa62989-26b1-46ca-8234-233026d9c3b4",
      "name": "Montar alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const e = $input.first().json;\nconst wf = (e.workflow && e.workflow.name) || 'workflow desconhecido';\nconst ex = e.execution || {};\nconst err = ex.error || {};\nconst msg = String(err.message || 'erro sem mensagem').replace(/\\d{11}/g, '[numero]').slice(0, 250);\nconst no = String(ex.lastNodeExecuted || (err.node && err.node.name) || '?').slice(0, 80);\nconst hora = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst texto = '🚨 *Dyno: erro em workflow*\\n' + wf + '\\nNó: ' + no + '\\nErro: ' + msg + '\\nExecução: ' + (ex.id || '?') + '\\n' + hora;\nconst sd = $getWorkflowStaticData('global');\nconst chave = wf + '|' + no;\nconst agora = Date.now();\nsd.ultimo = sd.ultimo || {};\nconst enviar = !(sd.ultimo[chave] && agora - sd.ultimo[chave] < 15 * 60 * 1000);\nif (enviar) sd.ultimo[chave] = agora;\nreturn [{ json: { enviar, texto, log: [{ nivel: 'error', componente: 'n8n:' + wf.slice(0, 40), evento: 'erro_workflow', correlacao: String(ex.id || ''), detalhe: { no, mensagem: msg } }] } }];"
      }
    },
    {
      "id": "5170d928-5815-464e-9b72-a1eedae3cec8",
      "name": "Supabase: registrar erro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        480,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://xvekgnbneeokihtjpbts.supabase.co/rest/v1/rpc/dyno_log_lote",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_itens: $json.log }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "13224ffc-6aeb-4585-ad34-0d613f9adc01",
      "name": "Avisar agora?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.enviar }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "d866f2a6-2d31-48b7-8bb3-aad3136b14a1",
      "name": "WhatsApp: avisar Daniel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://wa.dynoapp.com.br/message/sendText/dyno",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: \"5511930851325\", text: \"\\u200B\" + $json.texto, delay: 1000 }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Erro em workflow": {
      "main": [
        [
          {
            "node": "Montar alerta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Montar alerta": {
      "main": [
        [
          {
            "node": "Supabase: registrar erro",
            "type": "main",
            "index": 0
          },
          {
            "node": "Avisar agora?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Avisar agora?": {
      "main": [
        [
          {
            "node": "WhatsApp: avisar Daniel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "tags": [],
  "versionId": "ce0ab5c9-169a-44b1-9729-dd692e1a1f94"
}
