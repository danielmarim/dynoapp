    {
      "parameters": {
        "jsCode": "const NOMES = [\"Tabela transacoes\", \"Tabela tarefas\", \"Tabela lembretes\", \"Tabela contas\", \"Tabela assinaturas\", \"Tabela manutencoes\", \"Tabela veiculos\", \"Tabela extras\", \"Tabela memorias\", \"Tabela orcamentos\", \"Tabela mensagens\", \"Tabela rotina\"];\nconst n8n = {};\nlet total = 0;\nfor (const n of NOMES) {\n  let rows = [];\n  try { rows = $(n).all().map(i => i.json).filter(r => r && r.id != null); } catch (e) { rows = []; }\n  n8n[n.replace('Tabela ', 'assessor_')] = rows; total += rows.length;\n}\nlet supa = {};\ntry { supa = $('Supabase: exportar').first().json || {}; } catch (e) { supa = {}; }\nconst agora = DateTime.now().setZone('America/Sao_Paulo');\nconst nome = 'dyno-backup-' + agora.toFormat('yyyy-LL-dd_HHmm') + '.json';\nconst conteudo = JSON.stringify({ gerado_em: agora.toISO(), aviso: 'Contém dados pessoais. Guardar só nesta pasta privada.', supabase: supa, n8n_data_tables: n8n });\nreturn [{ json: { nome, total, bytes: conteudo.length }, binary: { data: { data: Buffer.from(conteudo, 'utf8').toString('base64'), mimeType: 'application/json', fileName: nome } } }];"
      },
