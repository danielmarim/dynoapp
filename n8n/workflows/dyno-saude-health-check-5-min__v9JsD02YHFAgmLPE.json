    {
      "parameters": {
        "jsCode": "const get = (n) => { try { return $(n).first().json || {}; } catch (e) { return {}; } };\nconst s = get('Checar Supabase'), a = get('Checar Asaas'), w2 = get('Checar WhatsApp (Dyno)');\nconst estado2 = w2.body && w2.body.instance && w2.body.instance.state;\n// Desde 05/10/2026 só o número do Dyno é monitorado (o número antigo, pesquisa-aereo, saiu do Assessor).\nconst comps = {\n  supabase: { ok: s.statusCode === 200, det: { http: s.statusCode || 0 } },\n  asaas: { ok: a.statusCode === 200, det: { http: a.statusCode || 0 } },\n  whatsapp_dyno: { ok: w2.statusCode === 200 && estado2 === 'open', det: { http: w2.statusCode || 0, estado: estado2 || 'desconhecido' } },\n  n8n: { ok: true, det: {} }\n};\nconst nomes = { supabase: 'Supabase (banco)', asaas: 'Asaas (cobrança)', whatsapp_dyno: 'WhatsApp (Dyno)', n8n: 'n8n' };\nconst sd = $getWorkflowStaticData('global');\nsd.est = sd.est || {};\ndelete sd.est.whatsapp;\nconst log = [], msgs = [];\nfor (const [k, c] of Object.entries(comps)) {\n  const e = sd.est[k] = sd.est[k] || { falhas: 0, alertado: false };\n  e.falhas = c.ok ? 0 : e.falhas + 1;\n  log.push({ nivel: c.ok ? 'info' : 'error', componente: k, evento: 'health', detalhe: Object.assign({ ok: c.ok }, c.det) });\n  if (!c.ok && e.falhas >= 2 && !e.alertado) { e.alertado = true; msgs.push('🔴 ' + nomes[k] + ' fora do ar (' + JSON.stringify(c.det) + ')'); }\n  if (c.ok && e.alertado) { e.alertado = false; msgs.push('🟢 ' + nomes[k] + ' voltou ao normal'); }\n}\n// Reconexão automática do número do Dyno: após 2 falhas seguidas, reinicia a instância (no máximo 1 vez a cada 15 min)\nlet reiniciar = false;\nconst ed = sd.est.whatsapp_dyno;\nif (comps.whatsapp_dyno.ok) { sd.tentativas = 0; }\nelse if (ed.falhas >= 2) {\n  const agora = Date.now();\n  if (!sd.ultimoRestart || agora - sd.ultimoRestart >= 15 * 60 * 1000) {\n    reiniciar = true;\n    sd.ultimoRestart = agora;\n    sd.tentativas = (sd.tentativas || 0) + 1;\n    log.push({ nivel: 'warn', componente: 'whatsapp_dyno', evento: 'restart_automatico', detalhe: { tentativa: sd.tentativas } });\n    if (sd.tentativas === 1) msgs.push('🔄 Reiniciando a conexão do WhatsApp (Dyno) automaticamente');\n    if (sd.tentativas === 3) msgs.push('⚠️ Reiniciei o WhatsApp (Dyno) 3 vezes e ele não voltou. Pode ser preciso ler o QR code de novo na Evolution.');\n  }\n}\nconst texto = msgs.length ? '*Dyno: saúde do sistema*\\n' + msgs.join('\\n') : '';\nreturn [{ json: { enviar: msgs.length > 0, reiniciar, texto, log } }];"
      },
