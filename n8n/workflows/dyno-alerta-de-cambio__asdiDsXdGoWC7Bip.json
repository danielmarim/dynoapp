        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.numero, text: String.fromCharCode(8203) + $json.texto, delay: 1200 }) }}",
        "options": {
