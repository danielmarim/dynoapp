    {
      "parameters": {
        "jsCode": "const ZW = String.fromCharCode(8203);\nconst numero = $('Normalizar mensagem').first().json.numero;\nconst r = $('Supabase: comando admin').first().json || {};\nif (r.acao === 'nao_admin') return [];\nlet texto = String(r.texto || '');\nif (r.acao === 'asaas') {\n  let a = {};\n  const nome = r.metodo === 'PUT' ? 'Asaas: alterar assinatura (admin)' : 'Asaas: cancelar assinatura (admin)';\n  try { a = $(nome).first().json || {}; } catch (e) { }\n  const ok = a.deleted === true || (r.metodo === 'PUT' && !!a.id && !a.errors && !a.error);\n  texto = ok ? String(r.texto_ok || '') : String(r.texto_falha || '');\n}\nif (!texto) texto = 'Não consegui executar o comando agora. Tente de novo em instantes.';\nconst out = [{ json: { corpo: { number: numero, text: ZW + texto, delay: 600 } } }];\n// Mensagem extra (ex.: convite pronto para encaminhar) vai separada, para poder ser encaminhada inteira\nif (r.extra) out.push({ json: { corpo: { number: numero, text: ZW + String(r.extra), delay: 1500 } } });\nreturn out;"
