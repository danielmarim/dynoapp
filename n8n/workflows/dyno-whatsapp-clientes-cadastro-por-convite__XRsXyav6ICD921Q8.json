    {
      "parameters": {
        "jsCode": "const ZW = String.fromCharCode(8203);\nconst NL = String.fromCharCode(10);\nconst numero = $('Normalizar mensagem').first().json.numero;\nconst p = $('Supabase: passo do cadastro').first().json;\nlet sub = {}; let cob = {};\ntry { sub = $('Asaas: criar assinatura').first().json || {}; } catch (e) { }\ntry { cob = $('Asaas: cobrança da assinatura').first().json || {}; } catch (e) { }\nconst link = (cob.data && cob.data[0] && cob.data[0].invoiceUrl) || '';\nconst falha = !sub.id || !link;\nconst primeiro = String(p.nome || '').split(' ')[0];\nconst anual = p.ciclo === 'YEARLY';\nconst valor = 'R$ ' + Number(p.valor || (anual ? 199.9 : 19.9)).toFixed(2).replace('.', ',');\nconst forma = p.forma === 'CREDIT_CARD' ? 'cartão de crédito' : 'Pix';\nconst venc = String(p.vencimento || '').split('-').reverse().join('/');\nlet texto;\nif (!falha) {\n  texto = 'Combinado, ' + primeiro + '! Plano *' + (anual ? 'anual' : 'mensal') + '* (' + valor + (anual ? ' por ano' : ' por mês') + '), pagamento por *' + forma + '*.' + NL + NL +\n    'Para ativar a assinatura, pague por este link' + (venc ? ' até ' + venc : '') + ':' + NL + link + NL + NL +\n    'Ao finalizar o pagamento, você concorda com nossos Termos de Uso (dynoapp.com.br/termos) e confirma que leu nossa Política de Privacidade (dynoapp.com.br/privacidade). Você pode cancelar os pagamentos recorrentes a qualquer momento pela área do cliente (dynoapp.com.br/conta).';\n} else {\n  texto = 'Recebi sua escolha, ' + primeiro + '! Tive um problema para gerar o link de pagamento agora; já avisei a equipe e te mando o link em seguida. Nada foi cobrado.';\n}\nreturn [{ json: { falha: falha, motivo: 'assinatura', usuario_id: p.usuario_id, corpo: { number: numero, text: ZW + texto, delay: 800 } } }];"
      },
