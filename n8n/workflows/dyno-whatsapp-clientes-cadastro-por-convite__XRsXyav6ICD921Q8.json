      "parameters": {
        "jsCode": "const ZW = String.fromCharCode(8203);\nconst raw = $input.first().json.body || $input.first().json;\nconst evento = String(raw.event || '').toLowerCase().replace('_', '.');\nif (evento && evento !== 'messages.upsert') return [];\nconst d = Array.isArray(raw.data) ? (raw.data[0] || {}) : (raw.data || {});\nconst key = d.key || {};\nconst jid = String(key.remoteJid || '');\nif (!jid || jid.includes('@g.us') || jid.includes('broadcast') || jid.includes('newsletter') || jid.startsWith('status@')) return [];\nif (key.fromMe === true) return [];\nconst digitos = s => String(s || '').split('@')[0].split(':')[0].replace(/\\D/g, '');\nconst alt = key.remoteJidAlt || key.senderPn || d.senderPn || '';\nconst numero = jid.endsWith('@lid') ? digitos(alt) : digitos(jid);\nconst m = d.message || {};\nlet texto = m.conversation || (m.extendedTextMessage && m.extendedTextMessage.text) || '';\nif (m.buttonsResponseMessage) texto = m.buttonsResponseMessage.selectedDisplayText || texto;\nif (m.listResponseMessage) texto = m.listResponseMessage.title || texto;\ntexto = String(texto || '').trim();\nif (!texto || texto.startsWith(ZW)) return [];\nif (!/^55[0-9]{10,11}$/.test(numero)) return [];\nconst cpfValido = c => {\n  if (c.length !== 11 || /^(\\d)\\1{10}$/.test(c)) return false;\n  const dv = n => { let s = 0; for (let i = 0; i < n; i++) s += Number(c[i]) * (n + 1 - i); const r = (s * 10) % 11; return r === 10 ? 0 : r; };\n  return dv(9) === Number(c[9]) && dv(10) === Number(c[10]);\n};\nlet textoRpc = texto.slice(0, 500);\nlet cpf = '';\nif (/^__cpf_/.test(textoRpc)) textoRpc = '(texto)';\nconst soDig = texto.replace(/[\\s.\\-]/g, '');\nif (/^[0-9]{11}$/.test(soDig)) {\n  if (cpfValido(soDig)) { cpf = soDig; textoRpc = '__cpf_ok__'; } else { textoRpc = '__cpf_invalido__'; }\n}\nreturn [{ json: { numero: numero, texto: textoRpc, cpf: cpf, nome: String(d.pushName || '') } }];"
      },
