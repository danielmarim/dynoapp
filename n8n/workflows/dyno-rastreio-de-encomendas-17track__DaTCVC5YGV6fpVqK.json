      "typeVersion": 4.3,
      "position": [
        240,
        600
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "options": {
          "timeout": 15000
        },
        "url": "={{ 'https://xvekgnbneeokihtjpbts.supabase.co/rest/v1/dyno_rastreios?estado=eq.acompanhando&ultimo_evento=is.null&order=id&select=id,codigo,transportadora&limit=' + (($now.setZone('America/Sao_Paulo').hour >= 8 && $now.setZone('America/Sao_Paulo').hour < 21) ? 40 : 0) + '&criado_em=gte.' + encodeURIComponent($now.minus({ days: 3 }).toISO()) }}"
      },
      "notes": "08/10: primeiro status logo depois do cadastro (a cada 10 min, até aparecer o primeiro evento; até 3 dias)."
    }
