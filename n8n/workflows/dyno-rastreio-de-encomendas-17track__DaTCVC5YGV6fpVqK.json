{
  "id": "DaTCVC5YGV6fpVqK",
  "name": "Dyno | Rastreio de encomendas (17TRACK)",
  "description": "A cada 10 min registra no 17TRACK as encomendas novas; a cada 2h (8h-20h) consulta as acompanhadas e a Dina avisa no WhatsApp quando o status muda.",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
