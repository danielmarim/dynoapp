    {
      "id": "e51cf935-d0f0-4f85-85fb-61736ad3cc44",
      "name": "Montar p/ cérebro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "jsCode": "// 09/10: traduz a mensagem da API oficial (Meta) para o formato da Evolution que o cérebro já entende. canal='meta' faz o cérebro responder pela ponte.\nconst b = $('Corpo bruto').first().json.body || {};\nconst out = [];\nfor (const e of (b.entry || [])) for (const c of (e.changes || [])) {\n  const v = c.value || {};\n  const contatos = v.contacts || [];\n  for (const m of (v.messages || [])) {\n    const nome = ((contatos.find(x => x.wa_id === m.from) || contatos[0] || {}).profile || {}).name || '';\n    let message = {}, messageType = 'conversation';\n    const t = String(m.type || '');\n    if (t === 'text') message = { conversation: (m.text || {}).body || '' };\n    else if (t === 'image') { message = { imageMessage: { caption: (m.image || {}).caption || '', mimetype: (m.image || {}).mime_type || 'image/jpeg' } }; messageType = 'imageMessage'; }\n    else if (t === 'audio') { message = { audioMessage: { mimetype: (m.audio || {}).mime_type || 'audio/ogg', ptt: !!(m.audio || {}).voice } }; messageType = 'audioMessage'; }\n    else if (t === 'document') { const d = m.document || {}; message = { documentMessage: { fileName: d.filename || 'documento', mimetype: d.mime_type || '', caption: d.caption || '' } }; messageType = 'documentMessage'; }\n    else if (t === 'location') { const l = m.location || {}; message = { locationMessage: { degreesLatitude: l.latitude, degreesLongitude: l.longitude, name: l.name || '', address: l.address || '' } }; messageType = 'locationMessage'; }\n    else if (t === 'button') message = { conversation: (m.button || {}).text || '' };\n    else if (t === 'interactive') { const i = m.interactive || {}; message = { conversation: (i.button_reply || {}).title || (i.list_reply || {}).title || '' }; }\n    else if (t === 'contacts') message = { conversation: (m.contacts || []).slice(0, 5).map(k => { const p = (k.phones || [])[0] || {}; return '[contato compartilhado: ' + ((k.name || {}).formatted_name || 'sem nome') + ' — ' + (p.wa_id ? '+' + p.wa_id : (p.phone || 'sem número')) + ']'; }).join(' ') };\n    else continue;\n    out.push({ json: { event: 'messages.upsert', instance: 'dyno', canal: 'meta', sender: String((v.metadata || {}).display_phone_number || '') + '@s.whatsapp.net', data: { key: { remoteJid: String(m.from) + '@s.whatsapp.net', fromMe: false, id: String(m.id || '') }, pushName: nome, message, messageType, messageTimestamp: Number(m.timestamp) || 0 } } });\n  }\n}\nreturn out;",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
