      "parameters": {
        "jsCode": "const it = $input.first();\nlet corpo = '';\ntry { const buf = await this.helpers.getBinaryDataBuffer(0, 'data'); corpo = buf.toString('utf8'); } catch (e) { corpo = ''; }\nconst h = it.json.headers || {};\nreturn [{ json: { corpo, assinatura: String(h['x-hub-signature-256'] || ''), body: it.json.body || {} } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
