      ],
      "parameters": {
        "jsCode": "// Pedido vindo do cérebro: { op: 'exportar' | 'apagar', autor, numero, nome }\nconst p = $input.first().json || {};\nconst FAM = ['Daniel', 'Quézia', 'Eliezer'];\nlet op = p.op === 'apagar' ? 'apagar' : 'exportar';\nif (op === 'apagar' && FAM.includes(p.autor)) op = 'negado';\nif (!p.autor || !p.numero) return [];\nreturn [{ json: { op, autor: String(p.autor), numero: String(p.numero), nome: String(p.nome || '') } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
