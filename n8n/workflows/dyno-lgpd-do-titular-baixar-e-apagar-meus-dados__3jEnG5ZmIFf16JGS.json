    {
      "id": "a18c7eb3-4957-4d20-b925-d272bd3313a1",
      "name": "Drive: só deste titular",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5560,
        -60
      ],
      "parameters": {
        "jsCode": "// Só apaga arquivos cujo nome termina exatamente com _<autor>.jpg ou _<autor>_<arquivo>.pdf\nconst autor = $('Preparar').first().json.autor;\nconst esc = autor.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst re = new RegExp('_' + esc + '(\\\\.jpg|_.*\\\\.pdf)$');\nconst out = $input.all().filter(i => i.json && i.json.id && re.test(String(i.json.name || '')));\nreturn out.length ? out : [{ json: { id: '' } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
