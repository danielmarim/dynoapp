    {
      "parameters": {
        "jsCode": "const p = $('Preparar').first().json;\nconst limpa = (rows) => rows.map(i => i.json).filter(r => r && r.id != null);\nconst NOMES = [\"Ler transações\", \"Ler tarefas\", \"Ler lembretes\", \"Ler contas\", \"Ler assinaturas\", \"Ler manutenções\", \"Ler veículos\", \"Ler extras\", \"Ler memórias\", \"Ler orçamentos\", \"Ler mensagens\"];\nconst dados = {};\nfor (const n of NOMES) { try { dados[n.replace('Ler ', '')] = limpa($(n).all()); } catch (e) { dados[n.replace('Ler ', '')] = []; } }\nlet cad = {};\ntry { cad = $('Supabase: dados do cadastro').first().json || {}; } catch (e) { cad = {}; }\nconst total = Object.values(dados).reduce((s, l) => s + l.length, 0);\nconst arquivo = {\n  gerado_em: new Date().toISOString(),\n  controlador: 'DM OBSERVAIT SOLUCOES EM TECNOLOGIA LTDA, CNPJ 65.176.391/0001-45 (Dyno)',\n  contato_privacidade: 'privacidade@dynoapp.com.br',\n  titular: p.autor,\n  cadastro: cad.cadastro || null,\n  pagamentos: cad.pagamentos || [],\n  feedback: cad.feedback || [],\n  registros_do_assistente: dados\n};\nconst json = JSON.stringify(arquivo, null, 2);\nconst b64 = Buffer.from(json, 'utf8').toString('base64');\nconst NL = String.fromCharCode(10);\nconst primeiro = (p.nome || p.autor).split(' ')[0];\nconst legenda = String.fromCharCode(8203) + (p.op === 'apagar'\n  ? 'Antes de apagar, aqui vai uma cópia de tudo o que estava guardado (' + total + ' registros), em formato aberto (JSON).'\n  : 'Prontinho, ' + primeiro + '! Aqui está a cópia dos seus dados no Dyno: cadastro, pagamentos e ' + total + ' registros do assistente, em formato aberto (JSON).' + NL + 'Se tiver qualquer dúvida, escreva para privacidade@dynoapp.com.br.');\nreturn [{ json: { op: p.op, numero: p.numero, total, corpo: { number: p.numero, mediatype: 'document', mimetype: 'application/json', fileName: 'meus-dados-dyno.json', media: b64, caption: legenda, delay: 800 } } }];"
      },
