        "jsCode": "// 10/10: a pessoa pode ter mais de uma conta Google conectada (pessoal e institucional): revoga cada uma.\nconst r = $('Supabase: anonimizar cadastro').first().json || {};\nconst lista = (Array.isArray(r.google_refresh_tokens) && r.google_refresh_tokens.length ? r.google_refresh_tokens : [r.google_refresh_token]).filter(Boolean);\nif (!lista.length) return [{ json: { token: 'nenhum' } }];\nreturn lista.map(t => ({ json: { token: t } }));",
