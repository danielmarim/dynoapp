    {
      "parameters": {
        "jsCode": "const p = $('Preparar').first().json;\nconst ZW = String.fromCharCode(8203), NL = String.fromCharCode(10);\nlet r = {};\ntry { r = $('Supabase: anonimizar cadastro').first().json || {}; } catch (e) { r = {}; }\nconst primeiro = (p.nome || p.autor).split(' ')[0];\nconst ok = r.ok === true;\nconst usuario = ok\n  ? 'Pronto, ' + primeiro + '. Apaguei seus registros do Dyno (gastos, tarefas, lembretes, memórias, conversas e comprovantes), encerrei seu acesso e removi seu cadastro de pagamento, sem nenhuma cobrança.' + NL + NL + 'Pela lei fiscal, só o histórico de pagamentos já feitos fica guardado pelo prazo obrigatório. Obrigado por ter testado o Dyno 💚'\n  : 'Não consegui concluir a exclusão agora. Já avisei a equipe e ela termina manualmente em até 15 dias. Dúvidas: privacidade@dynoapp.com.br.';\nconst admin = '*Dyno (LGPD):* ' + p.autor + ' pediu a exclusão dos dados pelo WhatsApp. ' + (ok ? 'Feito: tabelas do assistente, comprovantes no Drive, cadastro anonimizado e Asaas removido.' : 'FALHOU na etapa do Supabase; conclua manualmente (prazo de 15 dias).');\nreturn [\n  { json: { corpo: { number: p.numero, text: ZW + usuario, delay: 1200 } } },\n  { json: { corpo: { number: '5511930851325', text: ZW + admin, delay: 1500 } } }\n];"
      },
