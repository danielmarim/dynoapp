      "position": [
        6060,
        -200
      ],
      "parameters": {
        "jsCode": "const r = $('Supabase: anonimizar cadastro').first().json || {};\nconst out = [];\nif (r.asaas_subscription_id) out.push({ json: { caminho: '/subscriptions/' + r.asaas_subscription_id } });\nif (r.asaas_customer_id) out.push({ json: { caminho: '/customers/' + r.asaas_customer_id } });\nif (!out.length) out.push({ json: { caminho: '' } });\nreturn out;",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },
