      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Agente 3 (07/10/2026): faxina financeira semanal. Uma mensagem por cliente com sugestões + resumo ao Daniel.\nconst ZW = String.fromCharCode(8203), NL = String.fromCharCode(10);\nconst lista = $input.all().map(i => i.json).filter(x => x && x.autor && x.numero && x.texto);\nconst out = lista.map(x => ({ json: { number: String(x.numero), text: ZW + x.texto, delay: 1200 } }));\nconst total = lista.reduce((s, x) => s + (Number(x.sugestoes) || 0), 0);\nconst resumo = '🧹 *Faxina financeira da semana*' + NL + (out.length ? 'Enviei sugestões para ' + out.length + ' cliente(s), ' + total + ' ajuste(s) no total: ' + lista.map(x => x.autor + ' (' + x.sugestoes + ')').join(', ') + '. Eles respondem AJUSTAR ou IGNORAR.' : 'Nenhum cliente com ajuste para sugerir esta semana.');\nout.push({ json: { number: '5511930851325', text: ZW + resumo, delay: 800 } });\nreturn out;"
      }
    },
