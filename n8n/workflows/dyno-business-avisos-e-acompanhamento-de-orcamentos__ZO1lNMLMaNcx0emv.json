        224,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://xvekgnbneeokihtjpbts.supabase.co/rest/v1/rpc/biz_avisos_pendentes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
