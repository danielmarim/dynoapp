    {
      "id": "9bb980c5-4cbd-48fc-9eee-b3554992976f",
      "name": "Um por link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        700
      ],
      "parameters": {
        "jsCode": "const lista = $input.all().map(i => i.json).flatMap(x => Array.isArray(x) ? x : [x]).filter(x => x && x.link_id);\nreturn lista.map(x => ({ json: x }));\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "f7f78c66-6c0f-4cc6-8849-e39ecc5454ce",
      "name": "Asaas: remover link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        672,
        700
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "DELETE",
        "options": {
          "timeout": 20000
        },
        "url": "={{ 'https://api.asaas.com/v3/paymentLinks/' + encodeURIComponent($json.link_id) }}"
      },
      "onError": "continueRegularOutput"
    }
  ],
