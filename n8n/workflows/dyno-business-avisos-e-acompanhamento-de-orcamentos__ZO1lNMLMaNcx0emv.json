    {
      "id": "58192b6a-0ceb-4497-baa7-256237897de4",
      "name": "Montar envios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Grupo do vendedor: cabeçalho Dyno Business + marcador invisível (o bot do grupo ignora). Cliente final: texto puro.\nconst NL = String.fromCharCode(10), ZW = String.fromCharCode(8203);\nconst lista = $input.all().map(i => i.json).flatMap(x => Array.isArray(x) ? x : [x]).filter(x => x && x.id && x.destino && x.texto);\nreturn lista.map(a => { const grupo = String(a.destino).endsWith('@g.us'); return { json: { id: a.id, destino: a.destino, grupo, texto_puro: a.texto, corpo: { number: a.destino, text: grupo ? ZW + '*💼 Dyno Business*' + NL + a.texto : a.texto, delay: 800 } } }; });\n"
      }
    },
    {
      "id": "3d7ca708-54af-410a-ac9f-dd69b57cc5e9",
      "name": "Enviar (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        672,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://wa.dynoapp.com.br/message/sendText/dyno",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.corpo) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "id": "c41e32e4-786a-4dfa-bc02-bbfefcead11b",
      "name": "Marcar enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://xvekgnbneeokihtjpbts.supabase.co/rest/v1/rpc/biz_aviso_marcar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_id: $(\"Montar envios\").all()[$itemIndex].json.id, p_erro: ($json.error ? String($json.error.message || $json.error).slice(0, 200) : null) }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "844ae263-30e4-47da-84c4-ef851e7e5c2a",
      "name": "Foi para o grupo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $(\"Montar envios\").all()[$itemIndex].json.grupo === true }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "61481db3-9579-449d-8c4c-0e94d7c9a4d5",
      "name": "Registrar no histórico do grupo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://xvekgnbneeokihtjpbts.supabase.co/rest/v1/rpc/biz_registrar_msgs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p: { jid: $(\"Montar envios\").all()[$itemIndex].json.destino, msgs: [{ papel: \"assistente\", texto: $(\"Montar envios\").all()[$itemIndex].json.texto_puro }] } }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "0bc295f7-525b-4383-b695-1c305196f557",
