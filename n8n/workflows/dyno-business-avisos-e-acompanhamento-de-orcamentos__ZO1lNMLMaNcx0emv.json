    {
      "id": "6421f6f9-847b-4e4b-b487-ef84b2f81b91",
      "name": "Links pendentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        480
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "{}",
        "method": "POST",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://xvekgnbneeokihtjpbts.supabase.co/rest/v1/rpc/biz_asaas_pendentes"
      },
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "id": "00d7580a-7b4e-4782-9956-53c97d1d6a42",
      "name": "Um por venda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        480
      ],
      "parameters": {
        "jsCode": "// Uma venda por item (a RPC devolve uma lista; o nó HTTP pode ter dividido em itens).\nconst lista = $input.all().map(i => i.json).flatMap(x => Array.isArray(x) ? x : [x]).filter(x => x && x.venda_id && Number(x.valor) > 0);\nreturn lista.map(v => ({ json: v }));\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "f5eeca06-40ef-4353-b3be-81f9646a2ee7",
      "name": "Asaas: link Pix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        672,
        480
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={{ JSON.stringify({ name: $json.nome + ' (Pix)', description: $json.descricao, value: Number($json.valor), billingType: 'PIX', chargeType: 'DETACHED', dueDateLimitDays: 3, notificationEnabled: false, isAddressRequired: false, externalReference: $json.ref }) }}",
        "method": "POST",
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://api.asaas.com/v3/paymentLinks"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "c47ac278-9f24-41e4-88bf-d2772ffc2095",
      "name": "Asaas: link cartão",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        896,
        480
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={{ (() => { const v = $('Um por venda').all()[$itemIndex].json; const p = Number(v.parcelas) || 1; const b = { name: v.nome + ' (cartão)', description: v.descricao, value: Number(v.valor), billingType: 'CREDIT_CARD', chargeType: p > 1 ? 'INSTALLMENT' : 'DETACHED', notificationEnabled: false, isAddressRequired: false, externalReference: v.ref }; if (p > 1) b.maxInstallmentCount = p; return JSON.stringify(b); })() }}",
        "method": "POST",
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://api.asaas.com/v3/paymentLinks"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "118d1536-0a40-46fb-b799-9ff5c3662e95",
      "name": "Juntar links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        480
      ],
      "parameters": {
        "jsCode": "// Junta os dois links de cada venda (mesma ordem de itens) para salvar no Supabase.\nconst vendas = $('Um por venda').all();\nconst pix = $('Asaas: link Pix').all();\nconst car = $input.all();\nconst msg = r => { const j = (r && r.json) || {}; if (j.error) return String(j.error.message || j.error).slice(0, 250); if (Array.isArray(j.errors) && j.errors.length) return j.errors.map(e => e.description || e.code).join('; ').slice(0, 250); return ''; };\nreturn vendas.map((v, i) => {\n  const p = (pix[i] && pix[i].json) || {}; const c = (car[i] && car[i].json) || {};\n  const erro = msg(pix[i]) || msg(car[i]) || (!p.url || !c.url ? 'resposta sem url' : '');\n  return { json: { p: { venda_id: v.json.venda_id, valor: v.json.valor, pix_id: p.id || null, pix_url: p.url || null, cartao_id: c.id || null, cartao_url: c.url || null, erro } } };\n});\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "7d29347c-bedf-4606-9332-a1830eb7a3f7",
      "name": "Salvar links",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1344,
        480
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "method": "POST",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://xvekgnbneeokihtjpbts.supabase.co/rest/v1/rpc/biz_asaas_links_salvar"
      }
    },
    {
      "id": "11a337d7-a939-445d-81e1-96ccae8427c1",
      "name": "Links para desativar",
