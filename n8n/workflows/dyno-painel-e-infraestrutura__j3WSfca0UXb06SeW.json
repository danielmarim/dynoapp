        "jsCode": "const r = $input.first().json;\nif (r.ok !== true) return [{ json: { enviar: false, texto: '' } }];\nconst sd = $getWorkflowStaticData('global');\nconst problemas = [];\nif (r.disco >= 85) problemas.push('disco em ' + r.disco + '%');\nif (r.mem >= 90) problemas.push('memória em ' + r.mem + '%');\nif (r.cpu >= 95) problemas.push('CPU em ' + r.cpu + '%');\nconst agora = Date.now();\nconst enviar = problemas.length > 0 && !(sd.ult && agora - sd.ult < 60 * 60 * 1000);\nif (enviar) sd.ult = agora;\nreturn [{ json: { enviar, texto: '🟠 *Dyno: servidor sob pressão*\\n' + problemas.join(', ') } }];"
