  "nodes": [
    {
      "id": "e30daa5a-0968-4ad9-befe-36933bfd35df",
      "name": "A cada 2 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "ca71dab4-6bea-4869-b798-2f8990b7cfa8",
      "name": "Supabase: avisos pendentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://xvekgnbneeokihtjpbts.supabase.co/rest/v1/rpc/dyno_avisos_admin_pegar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "ea0d210d-2b50-4bcd-9c83-ef77a55747dc",
      "name": "Separar avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Fila dyno_avisos_admin: WhatsApp ao Daniel e, quando houver, e-mail.\nconst ZW = String.fromCharCode(8203);\nconst lista = $input.all().map(i => i.json).flatMap(x => Array.isArray(x) ? x : [x]).filter(x => x && x.texto);\nreturn lista.map(a => ({ json: { id: a.id, tipo: a.tipo, tem_email: !!a.email_para, email_para: a.email_para || '', email_assunto: a.email_assunto || '', email_texto: a.email_texto || '', corpo: { number: '5511930851325', text: ZW + a.texto, delay: 600 } } }));"
      }
    },
    {
      "id": "3e4e2ce4-62da-4fc4-9d0c-45adaef8b59c",
      "name": "WhatsApp: avisar Daniel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        672,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://wa.dynoapp.com.br/message/sendText/dyno",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.corpo) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2000
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "id": "7e9b4917-9301-4d35-a381-a7210b2f2810",
      "name": "Tem e-mail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "e1",
              "leftValue": "={{ $('Separar avisos').item.json.tem_email }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "0a041b40-9a6a-4981-b1b0-155427a72c5a",
      "name": "E-mail: feedback",
