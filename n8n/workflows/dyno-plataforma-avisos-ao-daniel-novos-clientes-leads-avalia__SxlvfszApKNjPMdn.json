      "typeVersion": 2.1,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "fromEmail": "Dyno <suporte@dynoapp.com.br>",
        "toEmail": "={{ $('Separar avisos').item.json.email_para }}",
        "subject": "={{ $('Separar avisos').item.json.email_assunto }}",
        "emailFormat": "text",
        "text": "={{ $('Separar avisos').item.json.email_texto }}",
        "options": {
          "appendAttribution": false
        }
      },
      "webhookId": "1e838f1c-6d53-4a9f-a053-ce16a10dad10",
      "onError": "continueRegularOutput",
      "disabled": false
    }
  ],
