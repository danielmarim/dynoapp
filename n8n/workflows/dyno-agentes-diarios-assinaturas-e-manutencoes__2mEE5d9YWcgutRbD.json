    {
      "parameters": {
        "jsCode": "// Agentes diários: assinaturas (aviso 2 dias antes), manutenções (data/km; anuais 15 dias antes) e pedido de km mensal.\nconst TZ = 'America/Sao_Paulo';\nconst GRUPO = '120363412854461070@g.us';\nconst hoje = DateTime.now().setZone(TZ).startOf('day');\nconst agoraISO = DateTime.now().toUTC().toISO();\nconst rows = n => { try { return $(n).all().map(i => i.json).filter(r => r && r.id != null); } catch (e) { return []; } };\nconst dia = v => v ? DateTime.fromISO(String(v)).setZone(TZ).startOf('day') : null;\nconst brl = v => 'R$ ' + Number(v || 0).toFixed(2).replace('.', ',');\nconst quando = d => { const n = Math.round(d.diff(hoje, 'days').days); return n === 0 ? 'hoje' : n === 1 ? 'amanhã' : n <= 6 ? d.setLocale('pt-BR').toFormat(\"cccc (dd/LL)\") : d.toFormat('dd/LL/yyyy'); };\nconst kmFmt = n => Math.round(n).toLocaleString('pt-BR');\nconst out = [];\nconst msgs = {}; // autor -> linhas\nconst add = (autor, linha) => { (msgs[autor] = msgs[autor] || []).push(linha); };\n\n// Assinaturas\nfor (const a of rows('Assinaturas ativas')) {\n  const autor = a.autor || 'Daniel';\n  let p = dia(a.proxima_cobranca);\n  if (!p) continue;\n  let mudou = false;\n  while (p < hoje) { p = p.plus(a.ciclo === 'anual' ? { years: 1 } : { months: 1 }); mudou = true; }\n  let avisado = mudou ? '' : String(a.avisado_para || '');\n  const dias = Math.round(p.diff(hoje, 'days').days);\n  if (dias >= 0 && dias <= 2 && avisado !== p.toISODate()) {\n    add(autor, '🔁 A assinatura *' + a.nome + '*' + (a.valor ? ' (' + brl(a.valor) + ')' : '') + ' renova ' + quando(p) + '. Ainda está usando? Se não, cancela no app e me avisa que eu tiro da lista.');\n    avisado = p.toISODate(); mudou = true;\n  }\n  if (mudou) out.push({ json: { tipo: 'upd_assin', id: a.id, proxima_cobranca: p.toUTC().toISO(), avisado_para: avisado } });\n}\n\n// Veículos: km estimado\nconst veics = rows('Veículos ativos');\nconst kmEst = v => (v && v.km_atual != null) ? v.km_atual + (Number(v.km_por_dia) || 0) * Math.max(0, hoje.diff(dia(v.km_data) || hoje, 'days').days) : null;\n\n// Manutenções\nfor (const m of rows('Manutenções ativas')) {\n  const autor = m.autor || 'Daniel';\n  const ultimo = dia(m.ultimo_aviso);\n  if (ultimo && hoje.diff(ultimo, 'days').days < 7) continue;\n  const pd = dia(m.proxima_data);\n  const vs = veics.filter(v => (v.autor || 'Daniel') === autor);\n  const v = vs.find(x => String(x.apelido || '').toLowerCase() === String(m.bem || '').toLowerCase()) || (vs.length === 1 && ['carro', 'moto'].includes(String(m.bem)) ? vs[0] : null);\n  const est = kmEst(v);\n  const anual = (!m.intervalo_dias && !m.intervalo_km) || Number(m.intervalo_dias) >= 300;\n  const janela = anual ? 15 : 7;\n  const porData = pd && pd.diff(hoje, 'days').days <= janela;\n  const porKm = m.proxima_km && est != null && est >= m.proxima_km - 500;\n  if (!porData && !porKm) continue;\n  const partes = [];\n  if (pd) partes.push(pd < hoje ? 'venceu em ' + pd.toFormat('dd/LL') : 'prevista p/ ' + quando(pd));\n  if (m.proxima_km) partes.push('aos ' + kmFmt(m.proxima_km) + ' km' + (est != null ? ' (pelas minhas contas o ' + (m.bem || 'carro') + ' está com ~' + kmFmt(est) + ' km)' : ''));\n  add(autor, '🔧 *' + m.item + '*' + (m.bem ? ' do ' + m.bem : '') + ': ' + partes.join(' ou ') + '. Já resolveu? Me avisa (com ' + (m.proxima_km ? 'km e ' : '') + 'valor, se tiver) que eu registro e calculo a próxima.');\n  out.push({ json: { tipo: 'upd_manut', id: m.id, ultimo_aviso: agoraISO } });\n}\n\n// Pedido de km (a cada 30 dias)\nfor (const v of veics) {\n  const autor = v.autor || 'Daniel';\n  const kd = dia(v.km_data);\n  const up = dia(v.ultimo_pedido_km);\n  if (kd && hoje.diff(kd, 'days').days < 30) continue;\n  if (up && hoje.diff(up, 'days').days < 30) continue;\n  add(autor, '🚗 Qual a quilometragem do ' + (v.apelido || 'carro') + ' hoje? É só me mandar o número que eu acompanho as manutenções.');\n  out.push({ json: { tipo: 'upd_veic', id: v.id, ultimo_pedido_km: agoraISO } });\n}\n\nfor (const [autor, linhas] of Object.entries(msgs)) {\n  out.push({ json: { tipo: 'msg', numero: GRUPO, autor, texto: autor + ', uns lembretes rápidos:\\n' + linhas.join('\\n') } });\n}\nreturn out;\n"
      },
