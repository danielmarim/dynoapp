    {
      "parameters": {
        "jsCode": "// Família recebe no grupo; clientes do piloto no privado; quem não está no cadastro não recebe nada.\nconst FAMS = ['Daniel', 'Quézia', 'Eliezer'];\nconst GRUPO = '120363412854461070@g.us';\nlet dest = {};\ntry { dest = $('Supabase: destinos').first().json || {}; } catch (e) { dest = {}; }\nconst out = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  if (j.tipo !== 'msg') { out.push(it); continue; }\n  if (FAMS.includes(j.autor)) { out.push({ json: { ...j, numero: GRUPO } }); continue; }\n  const n = String(dest[j.autor] || '');\n  if (/^\\d{12,13}$/.test(n)) out.push({ json: { ...j, numero: n } });\n}\nreturn out;"
      },
