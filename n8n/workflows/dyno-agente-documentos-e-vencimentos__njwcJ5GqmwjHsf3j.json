      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Documentos e vencimentos (08/10/2026): uma mensagem da Dina por pessoa com os documentos que chegaram num marco (90/60/30/7 dias, no dia).\nconst ZW = String.fromCharCode(8203), NL = String.fromCharCode(10);\nconst lista = $input.all().map(i => i.json).filter(x => x && x.autor && x.numero && x.texto);\nreturn lista.map(x => ({ json: { number: String(x.numero), text: ZW + '*⏰ Dina*' + NL + x.texto, delay: 1200 } }));"
      }
    },
